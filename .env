# Environment Variables for Fetal Health App

# MongoDB Connection String (get from MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/fetal_health?retryWrites=true&w=majority

# ML Service URL (get from Render after deployment)
ML_SERVICE_URL=https://your-ml-service.onrender.com

# JWT Secret (generate a random string)
JWT_SECRET=your-secure-jwt-secret-here